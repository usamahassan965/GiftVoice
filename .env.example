# --- Free-tier API keys -------------------------------------------------
# Groq (speech-to-text + fallback LLM): https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio (Gemini Flash LLM): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Pexels (product photos for seed script): https://www.pexels.com/api/
PEXELS_API_KEY=
# Stripe TEST mode secret key (sk_test_...): https://dashboard.stripe.com/test/apikeys
# Leave empty to use the built-in mock checkout.
STRIPE_SECRET_KEY=

# --- Models ---------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Voice ------------------------------------------------------------------
# edge (edge-tts: ~1 s to first audio, incl. Urdu) | kokoro (local, English; ~3-5 s per sentence on a laptop CPU)
TTS_ENGINE=edge
KOKORO_VOICE=af_heart
EDGE_VOICE_EN=en-US-AvaNeural
EDGE_VOICE_UR=ur-PK-UzmaNeural

# --- App ----------------------------------------------------------------------
STORE_NAME=GiftVoice
CURRENCY=USD
FRONTEND_URL=http://localhost:3000
